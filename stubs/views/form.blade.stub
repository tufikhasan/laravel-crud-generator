<div class="grid grid-cols-1 xl:grid-cols-3 gap-5 items-start">
    {{-- Left Column: Core Information --}}
    <div class="xl:col-span-2 space-y-5">
        <div class="bg-white rounded-2xl border border-secondary-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-secondary-100 flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-secondary-900">{{ ModelName }} Information</h3>
                    <p class="text-[11px] text-secondary-400">Core details</p>
                </div>
            </div>
            <div class="p-6 space-y-4">
                <x-input label="Name" name="name" :value="old('name', ${{ modelName }}?->name ?? '')" placeholder="e.g. My {{ ModelName }}" required />
                <x-input label="Slug (URL Key)" name="slug" :value="old('slug', ${{ modelName }}?->slug ?? '')" placeholder="auto-generated from name" />
                <div class="md:col-span-2">
                    <x-textarea label="Description" name="description" optional>{{ old('description', ${{ modelName }}?->description ?? '') }}</x-textarea>
                </div>
            </div>
        </div>

        {{-- SEO --}}
        <div class="bg-white rounded-2xl border border-secondary-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-secondary-100 flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-secondary-900">Search Engine Optimization</h3>
                    <p class="text-[11px] text-secondary-400">Help customers find this {{ model_name }} on Google</p>
                </div>
            </div>
            <div class="p-6 space-y-4">
                <x-input label="Meta Title" name="meta_title" :value="old('meta_title', ${{ modelName }}?->meta_title ?? '')" placeholder="SEO Title" optional />
                <x-textarea label="Meta Description" name="meta_description" placeholder="Brief description for search results" optional>{{ old('meta_description', ${{ modelName }}?->meta_description ?? '') }}</x-textarea>
                
                {{-- SERP Preview --}}
                <div class="mt-4 p-4 border border-secondary-200 rounded-xl bg-secondary-50/50">
                    <p class="text-[10px] font-bold text-secondary-400 uppercase tracking-wider mb-2">Search Engine Preview</p>
                    <div>
                        <p class="text-sm text-blue-600 font-medium truncate">{{ ${{ modelName }}?->meta_title ?? '{{ ModelName }} Title - Deshi Shop' }}</p>
                        <p class="text-xs text-green-700 truncate">https://deshishop.com/{{ model-names }}/{{ ${{ modelName }}?->slug ?? 'slug' }}</p>
                        <p class="text-xs text-secondary-600 mt-1 line-clamp-2">{{ ${{ modelName }}?->meta_description ?? 'This is an example of how your ' . '{{ model_name }}' . ' will appear in search engine results.' }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{-- Right Column: Settings --}}
    <div class="space-y-5">
        <div class="bg-white rounded-2xl border border-secondary-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-secondary-100 flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg bg-secondary-100 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-secondary-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <h3 class="text-sm font-bold text-secondary-900">Settings</h3>
            </div>
            <div class="p-5 space-y-4">
                <x-select label="Status" name="status">
                    <option value="1" @selected(old('status', ${{ modelName }}?->status ?? 1) == 1)>Active</option>
                    <option value="0" @selected(old('status', ${{ modelName }}?->status ?? 1) == 0)>Inactive</option>
                </x-select>
            </div>
        </div>

        {{-- Image --}}
        <div class="bg-white rounded-2xl border border-secondary-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-secondary-100 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-secondary-100 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-secondary-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                    </div>
                    <h3 class="text-sm font-bold text-secondary-900">{{ ModelName }} Image</h3>
                </div>
            </div>
            <div class="p-5">
                @if(isset(${{ modelName }}) && ${{ modelName }}?->image)
                    <div class="flex items-center justify-between p-3 border border-secondary-200 rounded-xl bg-secondary-50 mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center border border-secondary-200 text-secondary-500 shrink-0">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-secondary-900 line-clamp-1">{{ ${{ modelName }}?->image }}</p>
                                <p class="text-[10px] text-secondary-500">Image</p>
                            </div>
                        </div>
                        <label class="cursor-pointer text-secondary-400 hover:text-primary-600 transition-colors tooltip" title="Change Image">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" /></svg>
                            <input type="file" name="image" class="hidden" accept=".png,.jpg,.jpeg,.webp" />
                        </label>
                    </div>
                @else
                    <label class="block w-full border-2 border-dashed border-secondary-200 rounded-xl p-6 text-center hover:border-primary-400 hover:bg-primary-50/50 cursor-pointer transition-colors group">
                        <div class="w-10 h-10 bg-secondary-100 text-secondary-400 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-primary-100 group-hover:text-primary-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                        </div>
                        <span class="text-sm font-bold text-secondary-900 block group-hover:text-primary-700">Upload Image</span>
                        <span class="text-[10px] text-secondary-500 mt-1 block">PNG, JPG, WEBP up to 2MB</span>
                        <input type="file" name="image" class="hidden" accept=".png,.jpg,.jpeg,.webp" />
                    </label>
                @endif
            </div>
        </div>
    </div>
</div>
