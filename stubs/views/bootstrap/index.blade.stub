<x-layouts.dashboard title="{{ ModelNames }}" description="Manage and organize all {{ modelNames }}.">
<div class="container-fluid py-4">
    {{-- Header Actions --}}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <div>
            <h1 class="h3 m-0">{{ ModelNames }}</h1>
            <p class="text-muted small mb-0">Manage and organize all {{ modelNames }}.</p>
        </div>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.create') }}" class="btn btn-sm btn-primary">
                + Add {{ ModelName }}
            </a>
        </div>
    </div>

    {{-- Session Messages --}}
    @if(session('success'))
    <div class="alert alert-success" role="alert">
        {{ session('success') }}
    </div>
    @endif

    @if(session('error'))
    <div class="alert alert-danger" role="alert">
        {{ session('error') }}
    </div>
    @endif

    {{-- Filter & Search --}}
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="GET" action="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.index') }}" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-5">
                    <input type="text" class="form-control" name="search" value="{{ request('search') }}" placeholder="Search {{ ModelNames }}...">
                </div>
                <div class="col-sm-4">
                    <select class="form-select" name="status">
                        <option value="">All Status</option>
                        <option value="1" @selected(request('status') === '1')>Active</option>
                        <option value="0" @selected(request('status') === '0')>Inactive</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if(request('search') || request('status') !== null && request('status') !== '')
                        <a href="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.index') }}" class="btn btn-outline-secondary">Reset</a>
                    @endif
                </div>
            </form>
        </div>
    </div>

    {{-- Data Table --}}
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 50px;">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Slug</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col" class="text-end" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @forelse(${{ modelNames }} as ${{ modelName }})
                    <tr>
                        <td class="text-muted">{{ $loop->iteration }}</td>
                        <td>
                            <strong class="text-dark">{{ ${{ modelName }}->name }}</strong>
                        </td>
                        <td class="text-muted font-monospace small">{{ ${{ modelName }}->slug ?? '—' }}</td>
                        <td>
                            @if(${{ modelName }}->status)
                                <span class="badge bg-success bg-opacity-10 text-success border border-success">Active</span>
                            @else
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Inactive</span>
                            @endif
                        </td>
                        <td class="text-muted small">{{ ${{ modelName }}->created_at->diffForHumans() }}</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.show', ${{ modelName }}) }}" class="btn btn-outline-primary">View</a>
                                <a href="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.edit', ${{ modelName }}) }}" class="btn btn-outline-secondary">Edit</a>
                                <form action="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.destroy', ${{ modelName }}) }}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this {{ modelName }}? This action cannot be undone.')">
                                    @csrf
                                    @method('DELETE')
                                    <button type="submit" class="btn btn-outline-danger" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    @empty
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted mb-2">No {{ modelNames }} found</div>
                            <a href="{{ route('{{ RouteNamePrefix }}.{{ model_names }}.create') }}" class="btn btn-sm btn-primary">
                                Add the first one
                            </a>
                        </td>
                    </tr>
                    @endforelse
                </tbody>
            </table>
        </div>

        {{-- Pagination --}}
        @if(${{ modelNames }}->hasPages())
        <div class="card-footer bg-white pt-3 pb-0">
            {{ ${{ modelNames }}->links() }}
        </div>
        @endif
    </div>
</div>
</x-layouts.dashboard>
