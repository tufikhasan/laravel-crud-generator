<?php

namespace {{ RootNamespace }}\Http\Controllers\Admin;

use {{ RootNamespace }}\Http\Controllers\Controller;
use {{ RootNamespace }}\Http\Requests\{{ ModelName }}\Store{{ ModelName }}Request;
use {{ RootNamespace }}\Http\Requests\{{ ModelName }}\Update{{ ModelName }}Request;
use {{ RootNamespace }}\Models\{{ ModelName }};
use {{ RootNamespace }}\Services\{{ ModelName }}\{{ ModelName }}Service;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;

class {{ ModelName }}Controller extends Controller
{
    public function __construct(
        private readonly {{ ModelName }}Service $service,
    ) {}

    public function index(): View
    {
        ${{ modelNames }} = $this->service->paginate(15);

        return view('pages.admin.{{ model_names }}.index', compact('{{ modelNames }}'));
    }

    public function create(): View
    {
        return view('pages.admin.{{ model_names }}.create');
    }

    public function store(Store{{ ModelName }}Request $request): RedirectResponse
    {
        $this->service->create($request->validated());

        return redirect()->route('{{ RouteNamePrefix }}{{ model_names }}.index')
            ->with('success', '{{ ModelName }} created successfully.');
    }

    public function show(int|string ${{ modelName }}): View
    {
        ${{ modelName }} = $this->service->find(${{ modelName }});

        return view('pages.admin.{{ model_names }}.show', compact('{{ modelName }}'));
    }

    public function edit(int|string ${{ modelName }}): View
    {
        ${{ modelName }} = $this->service->find(${{ modelName }});

        return view('pages.admin.{{ model_names }}.edit', compact('{{ modelName }}'));
    }

    public function update(
        Update{{ ModelName }}Request $request,
        int|string ${{ modelName }},
    ): RedirectResponse {
        ${{ modelName }} = $this->service->find(${{ modelName }});
        $this->service->update(${{ modelName }}, $request->validated());

        return redirect()->back()
            ->with('success', '{{ ModelName }} updated successfully.');
    }

    public function destroy(int|string ${{ modelName }}): RedirectResponse
    {
        ${{ modelName }} = $this->service->find(${{ modelName }});
        $this->service->delete(${{ modelName }});

        return redirect()->route('{{ RouteNamePrefix }}{{ model_names }}.index')
            ->with('success', '{{ ModelName }} deleted successfully.');
    }
}
