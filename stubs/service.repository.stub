<?php

namespace {{ RootNamespace }}\Services\{{ ModelName }};

use {{ RootNamespace }}\Models\{{ ModelName }};
use {{ RootNamespace }}\Repositories\{{ ModelName }}\{{ ModelName }}Repository;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Str;

class {{ ModelName }}Service
{
    public function __construct(
        protected {{ ModelName }}Repository $repository
    ) {}

    public function paginate(int $perPage = 15): LengthAwarePaginator
    {
        return $this->repository->paginate($perPage);
    }

    public function find(int|string $id): ?{{ ModelName }}
    {
        return $this->repository->find($id);
    }

    public function create(array $data): {{ ModelName }}
    {
        // Example business logic
        if (isset($data['name']) && empty($data['slug'])) {
            $data['slug'] = Str::slug($data['name']);
        }

        return $this->repository->create($data);
    }

    public function update({{ ModelName }} ${{ modelName }}, array $data): {{ ModelName }}
    {
        // Example business logic
        if (isset($data['name']) && empty($data['slug'])) {
            $data['slug'] = Str::slug($data['name']);
        }

        $this->repository->update(${{ modelName }}, $data);

        return ${{ modelName }}->refresh();
    }

    public function delete({{ ModelName }} ${{ modelName }}): void
    {
        $this->repository->delete(${{ modelName }});
    }
}
