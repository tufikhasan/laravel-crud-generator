<?php

namespace {{ RootNamespace }}\Http\Controllers\Api;

use {{ RootNamespace }}\Http\Controllers\Controller;
use {{ RootNamespace }}\Http\Requests\{{ ModelName }}\Store{{ ModelName }}Request;
use {{ RootNamespace }}\Http\Requests\{{ ModelName }}\Update{{ ModelName }}Request;
use {{ RootNamespace }}\Http\Resources\{{ ModelName }}\{{ ModelName }}Resource;
use {{ RootNamespace }}\Models\{{ ModelName }};
use {{ RootNamespace }}\Services\{{ ModelName }}\{{ ModelName }}Service;
use Illuminate\Http\JsonResponse;

class {{ ModelName }}Controller extends Controller
{
    public function __construct(
        private readonly {{ ModelName }}Service $service,
    ) {}

    public function index(): JsonResponse
    {
        ${{ modelNames }} = {{ ModelName }}::latest()->paginate(15);

        return {{ ModelName }}Resource::collection(${{ modelNames }})
            ->additional([
                'success' => true,
                'message' => '{{ ModelName }} list retrieved successfully.',
            ])
            ->response()
            ->setStatusCode(200);
    }

    public function store(Store{{ ModelName }}Request $request): JsonResponse
    {
        ${{ modelName }} = $this->service->create($request->validated());

        return (new {{ ModelName }}Resource(${{ modelName }}))
            ->additional([
                'success' => true,
                'message' => '{{ ModelName }} created successfully.',
            ])
            ->response()
            ->setStatusCode(201);
    }

    public function show({{ ModelName }} ${{ modelName }}): JsonResponse
    {
        return (new {{ ModelName }}Resource(${{ modelName }}))
            ->additional([
                'success' => true,
                'message' => '{{ ModelName }} retrieved successfully.',
            ])
            ->response()
            ->setStatusCode(200);
    }

    public function update(
        Update{{ ModelName }}Request $request,
        {{ ModelName }} ${{ modelName }},
    ): JsonResponse {
        ${{ modelName }} = $this->service->update(${{ modelName }}, $request->validated());

        return (new {{ ModelName }}Resource(${{ modelName }}))
            ->additional([
                'success' => true,
                'message' => '{{ ModelName }} updated successfully.',
            ])
            ->response()
            ->setStatusCode(200);
    }

    public function destroy({{ ModelName }} ${{ modelName }}): JsonResponse
    {
        $this->service->delete(${{ modelName }});

        return response()->json([
            'success' => true,
            'message' => '{{ ModelName }} deleted successfully.',
        ]);
    }
}
